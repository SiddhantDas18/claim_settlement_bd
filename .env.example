# Copy this file to .env and fill in the values.

# Free key from https://aistudio.google.com (Get API key).
# Use fake/sample documents only — the free tier may use data to improve Google's models.
GEMINI_API_KEY=
# Check AI Studio for the current free-tier model names. gemini-2.5-flash's free tier allows only
# 20 requests/day (one evaluation run needs ~56), so the evaluation was run with gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite
# Which prompt in app/prompts/ the AI extraction uses (see prompt_experiments/README.md).
PROMPT_VERSION=extraction_v3

# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME (local Homebrew Postgres needs no password)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/claim_settlement
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Browser origins allowed to call this API (the frontend's address). JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Signs login tokens. Use a long random value, e.g. output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First admin account, created automatically on startup if it doesn't exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
